# Database
MONGO_URL=<YOUR_MONGODB_CONNECTION_STRING>
DB_NAME=coco_database

# Authentication. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=<YOUR_LONG_RANDOM_JWT_SECRET>
ADMIN_EMAIL=<YOUR_ADMIN_EMAIL>
ADMIN_PASSWORD=<YOUR_ADMIN_PASSWORD>

# Application and browser security
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# Google OAuth (Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:8001/api/auth/google/callback

# Password reset email (Resend)
RESEND_API_KEY=<YOUR_RESEND_API_KEY>
EMAIL_FROM=<YOUR_VERIFIED_SENDER>

# AI: official Google Gemini API
GOOGLE_API_KEY=<YOUR_GOOGLE_GEMINI_API_KEY>
AI_MODEL=gemini-3-flash-preview

# Optional live flight search (Amadeus)
AMADEUS_CLIENT_ID=<YOUR_AMADEUS_CLIENT_ID>
AMADEUS_CLIENT_SECRET=<YOUR_AMADEUS_CLIENT_SECRET>
AMADEUS_ENV=test

# Optional hotel pricing integration; OSM hotel discovery works without it
HOTEL_API_KEY=<YOUR_HOTEL_API_KEY>

# Frontend build-time API base (frontend/.env)
# REACT_APP_BACKEND_URL=http://localhost:8001
